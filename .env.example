# ANTHROPIC_API_KEY/DEFAULT_MODEL/FALLBACK_MODEL нужны только локальному CLI (consulting_agent.py).
# Веб-версия (web/backend) ходит за LLM через llm-router — см. LLM_ROUTER_* ниже.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_MODEL=claude-sonnet-4-6
FALLBACK_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=8000

# llm-router — общий сервис маршрутизации LLM (см. https://github.com/zugrov/llm-router).
# consulting-agent (web) работает на хосте через systemd, не в Docker — обращается по localhost.
LLM_ROUTER_URL=http://127.0.0.1:8020
LLM_ROUTER_INTERNAL_SECRET=
CONSULTANT_NAME=Максим Евгеньевич Зугров
CONSULTANT_PHONE=+79106407686
COMPANY_NAME=Максима Консалтинг
# Google Drive API key — для листинга папок (Google Cloud Console → Drive API)
GOOGLE_DRIVE_API_KEY=
# Production: сгенерировать — python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
# Production: https://agent.maxima-consulting.ru
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
