# llm-router — единая точка входа для LLM (CLI и веб).
# Модель выбирает llm-router по task_type=client_report.
# См. https://github.com/zugrov/llm-router
LLM_ROUTER_URL=http://127.0.0.1:8020
LLM_ROUTER_INTERNAL_SECRET=
LLM_ROUTER_PROJECT=maxima-consulting
LLM_ROUTER_TASK_TYPE=client_report
MAX_TOKENS=8000

CONSULTANT_NAME=Максим Евгеньевич Зугров
CONSULTANT_PHONE=+79808488480
COMPANY_NAME=Максима Консалтинг

# Google Drive API key — для листинга папок (Google Cloud Console → Drive API)
GOOGLE_DRIVE_API_KEY=
# Production: сгенерировать — python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
# Production: https://agent.maxima-consulting.ru
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
