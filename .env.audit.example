# Копировать: cp .env.audit.example .env.audit
# Изолированная среда аудита — не использует production clients.db и reports/

CLIENTS_DB_PATH=web/backend/data/clients_audit.db
REPORTS_DIR=reports/audit

# LLM — те же настройки, что в .env (llm-router локально или стенд)
LLM_ROUTER_URL=http://127.0.0.1:8020
LLM_ROUTER_INTERNAL_SECRET=
LLM_ROUTER_PROJECT=maxima-consulting-audit
LLM_ROUTER_TASK_TYPE=client_report
MAX_TOKENS=8000

CONSULTANT_NAME=Аудит (синтетические данные)
CONSULTANT_PHONE=+7 900 000-00-00
COMPANY_NAME=Максима Консалтинг — audit sandbox
